# App-tier secrets (.env.prod and each tier's) — NEVER commit
.env
.env.*

# Private keys
*.pem
*.key
*.priv
**/keys/*.priv

# Docker volumes + caches
**/postgres-data/
**/pgdata/

# Logs
**/log/
*.log

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# ── Generator output — NEVER commit ──────────────────────────────────────────
# The framework's generator (daksh.generators.generate-app-config) writes these
# from packages.json. Committing them would create a second definition that
# drifts from what the framework emits.
compose.yml
compose.dev.yml
compose.dev.override.yml
compose.staging.yml
Dockerfile.deps
Dockerfile.backend
Dockerfile.frontend
build-app.sh
nginx/
nginx.frontend.conf
log/
